  "zephyr": {
    "prerequisites": {
      "title": "Install required packages",
      "commands": [
        "sudo apt install zip unzip"
      ],
      "source_url": "https://dev.digicert.com/trustedge/install-and-run-trustedge-with-zephyr-rtos.html"
    },
    "install": {
      "title": "Clone TrustCore and build TrustEdge for Zephyr",
      "commands": [
        "git clone https://github.com/digicert/trustcore.git",
        "cd trustcore",
        "./scripts/ci/trustedge/ci_trustedge_build_zephyr.sh --zephyr-install",
        "cd ${ZEPHYR_BASE}",
        "git apply <path-to>/trustedge_zephyr.patch",
        "cd ${TRUSTCORE}",
        "./scripts/ci/trustedge/ci_trustedge_build_zephyr.sh --board native_sim"
      ],
      "source_url": "https://dev.digicert.com/trustedge/install-and-run-trustedge-with-zephyr-rtos.html"
    },
    "run_cli": {
      "title": "Run TrustEdge binary on Zephyr board",
      "commands": [
        "cd ${TRUSTCORE}",
        "./bin/trustedge"
      ],
      "source_url": "https://dev.digicert.com/trustedge/install-and-run-trustedge-with-zephyr-rtos.html"
    },
    "run_agent": {
      "title": "Start TrustEdge on Zephyr device",
      "commands": [
        "uart:~$ trustedge start",
        "uart:~$ trustedge status",
        "uart:~$ trustedge state"
      ],
      "source_url": "https://dev.digicert.com/trustedge/install-and-run-trustedge-with-zephyr-rtos.html"
    }
