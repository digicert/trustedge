{
  "x86_64": {
    "prerequisites": {
      "title": "Install required packages",
      "commands": [
        "sudo apt install wget unzip"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Required for downloading and extracting TrustEdge packages."
      ]
    },
    "install": {
      "title": "Download and install TrustEdge package",
      "commands": [
        "wget https://github.com/digicert/trustedge/releases/latest/download/trustedge-x64-deb.zip",
        "unzip trustedge-x64-deb.zip",
        "sudo dpkg -i trustedge_{{VERSION}}.x86_64.deb",
        "trustedge --version",
        "sudo adduser \"$(whoami)\" trustedge"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Replace {{VERSION}} with the actual version number (e.g., 24.7.2-2187)."
      ]
    },
    "tpm_provision": {
      "title": "Reset and provision TPM2 device",
      "commands": [
        "git clone https://github.com/digicert/trustedge.git",
        "cd trustedge/tools/SecureElement",
        "unzip tpm2_tools-x86_64-{{VERSION}}.zip",
        "unzip tpm2_tools-x86_64.zip",
        "sudo ./reset_tpm2.sh",
        "sudo ./provision_tpm2.sh",
        "sudo ./bin/digicert_tpm2_takeownership --sm=/dev/tpm0 --c --credfile=/etc/digicert/creds.tpm2",
        "sudo ./bin/digicert_tpm2_provision --sm=/dev/tpm0 --ekpwd= --ekalg=rsa --srkpwd= --srkalg=rsa --credfile=/etc/digicert/creds.tpm2",
        "sudo ./bin/smp_tpm2_getidstr_bin --w"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Assumes TPM device is /dev/tpm0; adjust if different."
      ]
    },
    "cert_selfsigned": {
      "title": "Generate self\u2011signed ML\u2011DSA certificates for PQC demo",
      "commands": [
        "sudo cp ca_csr.cnf /etc/digicert/keystore/conf",
        "sudo cp server_csr.cnf /etc/digicert/keystore/conf",
        "sudo trustedge certificate -a QS -g MLDSA_44 -o CA.key -x CA.crt -i ca_csr.cnf -da 3651",
        "sudo trustedge certificate -a QS -g MLDSA_44 -o server.key -x server.crt -i server_csr.cnf -da 3651 -sk CA.key -sc CA.crt"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Creates a root CA and a server certificate signed by that CA."
      ]
    },
    "cert_est": {
      "title": "Enroll a certificate via EST",
      "commands": [
        "trustedge certificate est --algorithm ECC --curve P256 --uri ${EST_URI} --csr-conf sample_est_csr.conf --key-alias eccTestKey --log-level INFO"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/est-enrollment.html",
      "notes": [
        "Replace ${EST_URI} with the actual EST endpoint."
      ]
    },
    "cert_scep": {
      "title": "Enroll a certificate via SCEP",
      "commands": [
        "trustedge certificate scep --scepc-serverURL ${SCEP_ENDPOINT} --scepc-serverType GEN_POST --csr-conf sample_scep_csr.cnf --algorithm RSA --size 2048 --key-alias myGenTap --scepc-challengePass ${SCEP_PASS} --scepc-pkiOperation PKCSReq --tap"
      ],
      "source_url": "https://dev.digicert.com/trustedge/cli-reference/trustedge-certificate-scep.html",
      "notes": [
        "Replace ${SCEP_ENDPOINT} and ${SCEP_PASS} with your SCEP server details."
      ]
    },
    "run_cli": {
      "title": "Publish and subscribe using TrustEdge MQTT client",
      "commands": [
        "trustedge mqtt --mqtt_servername broker.hivemq.com --mqtt_pub_topic house/bulb1 --mqtt_pub_message \"test message\" --mqtt_port 1883 --mqtt_clean_start",
        "trustedge mqtt --mqtt_servername broker.hivemq.com --mqtt_sub_topic house/bulb1 --mqtt_port 1883 --mqtt_clean_start"
      ],
      "source_url": "https://dev.digicert.com/trustedge/cli-reference/trustedge-mqtt.html",
      "notes": [
        "Demonstrates basic publish and subscribe."
      ]
    },
    "run_agent": {
      "title": "Configure and start TrustEdge agent",
      "commands": [
        "sudo trustedge agent --configure --trustedge-user trustedge --trustedge-group trustedge --bootstrap-zip ./<guid>.zip",
        "sudo systemctl start trustedge.service"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/initialize-and-start-trustedge-trustedge-agent.html",
      "notes": [
        "Replace <guid> with the actual bootstrap zip filename."
      ]
    },
    "pqc_demo": {
      "title": "Run the PQC MQTT demo (publisher and subscriber)",
      "commands": [
        "chmod +x consumer.sh",
        "./consumer.sh --broker mqtt-pqc-broker --port 8883 --keystore /etc/digicert/keystore",
        "chmod +x publisher.sh",
        "./publisher.sh --broker mqtt-pqc-broker --port 8883 --keystore /etc/digicert/keystore"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Subscriber must be started before the publisher."
      ]
    },
    "verify": {
      "title": "Verify generated certificates",
      "commands": [
        "trustedge certificate -pc /etc/digicert/keystore/certs/server.crt",
        "trustedge certificate -pc /etc/digicert/keystore/certs/CA.crt"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html",
      "notes": [
        "Displays certificate details in a readable format."
      ]
    }
  },
