{
  "x86_64": {
    "prerequisites": {
      "title": "Install required tools",
      "commands": [
        "sudo apt install wget unzip"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html"
    },
    "install": {
      "title": "Download and install TrustEdge package",
      "commands": [
        "wget https://github.com/digicert/trustedge/releases/download/trustedge_{{VERSION}}/trustedge_{{VERSION}}.x86_64.deb",
        "sudo dpkg -i trustedge_{{VERSION}}.x86_64.deb"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html"
    },
    "tpm_provision": {
      "title": "Reset, take ownership, and provision TPM2 device",
      "commands": [
        "sudo ./reset_tpm2.sh",
        "sudo ./bin/digicert_tpm2_takeownership --sm=/dev/tpm0 --c --credfile=/etc/digicert/creds.tpm2",
        "sudo ./bin/digicert_tpm2_provision --sm=/dev/tpm0 --ekpwd= --ekalg=rsa --srkpwd= --srkalg=rsa --credfile=/etc/digicert/creds.tpm2",
        "sudo ./bin/smp_tpm2_getidstr_bin --w"
      ],
      "source_url": "repo://trustedge/tools/SecureElement"
    },
    "cert_selfsigned": {
      "title": "Generate software\u2011based self\u2011signed certificates",
      "commands": [
        "trustedge certificate --algorithm RSA --size 2048 --output-file RSA_2048.pem",
        "trustedge certificate --algorithm ECC --curve P256 --output-file ECC_P256.pem",
        "trustedge certificate --algorithm QS --pq-alg MLDSA_65 --output-file MLDSA_65.pem"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/generate-software-based-private-key.html"
    },
    "cert_est": {
      "title": "Enroll certificate via EST",
      "commands": [
        "trustedge certificate est --uri $EST_URI",
        "trustedge certificate est --algorithm ECC --curve P256 --uri ${EST_URI} --csr-conf sample_est_csr.conf --key-alias eccTestKey --log-level INFO"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/est-enrollment.html"
    },
    "run_cli": {
      "title": "Display TrustEdge CLI help and version",
      "commands": [
        "trustedge --help",
        "trustedge --version"
      ],
      "source_url": "https://dev.digicert.com/trustedge/cli-reference/trustedge.html"
    },
    "run_agent": {
      "title": "Configure and start TrustEdge agent",
      "commands": [
        "sudo trustedge agent --configure --trustedge-user trustedge --trustedge-group trustedge --bootstrap-zip ./<guid.zip>",
        "sudo systemctl start trustedge.service"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/initialize-and-start-trustedge-trustedge-agent.html"
    },
    "pqc_demo": {
      "title": "Generate ML\u2011DSA certificates for PQC demo",
      "commands": [
        "trustedge certificate -a QS -g MLDSA_44 -o CA.pem -x CA.pem -i ca_csr.cnf -da 3651",
        "trustedge certificate -a QS -g MLDSA_44 -o server.pem -x server.pem -i server_csr.cnf -da 3651 -sk CA.pem -sc CA.pem"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html"
    },
    "verify": {
      "title": "Verify generated certificates",
      "commands": [
        "trustedge certificate -pc /etc/digicert/keystore/certs/server.pem",
        "trustedge certificate -pc /etc/digicert/keystore/certs/CA.pem"
      ],
      "source_url": "https://dev.digicert.com/trustedge/tutorials/using-pqc-to-secure-mqtt-with-trustedge.html"
    }
  },
